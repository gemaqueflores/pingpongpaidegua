# Copie para um arquivo local fora do Git e carregue no host/cron conforme sua operacao.
# Exemplo de destino local na VM:
#   /home/ubuntu/pingpongpaidegua/.runtime/alerts.env

# Cooldown global por chave de alerta, em segundos
PPG_ALERT_COOLDOWN_SECONDS=1800

# Roteamento padrao
PPG_ALERT_ROUTES_DEFAULT=discord:ops
PPG_ALERT_ROUTES_WARN=discord:ops,telegram:ops
PPG_ALERT_ROUTES_FAIL=discord:ops,telegram:ops,whatsapp:critico

# Roteamento fino por chave
PPG_ALERT_ROUTES_RECOVER_SUCCESS=discord:ops
PPG_ALERT_ROUTES_RECOVER_FAILED=discord:ops,telegram:ops,whatsapp:critico
PPG_ALERT_ROUTES_RECOVER_TOO_MANY_FAILURES=discord:ops,telegram:ops,whatsapp:critico
PPG_ALERT_ROUTES_VM_HEALTH_WARN=discord:ops,telegram:ops
PPG_ALERT_ROUTES_VM_HEALTH_FAIL=discord:ops,telegram:ops,whatsapp:critico

# Discord
PPG_DISCORD_WEBHOOK_URL_OPS=

# Telegram
PPG_TELEGRAM_BOT_TOKEN_OPS=
PPG_TELEGRAM_CHAT_ID_OPS=

# WhatsApp Cloud API
PPG_WHATSAPP_TOKEN_CRITICO=
PPG_WHATSAPP_PHONE_NUMBER_ID_CRITICO=
PPG_WHATSAPP_TO_CRITICO=
PPG_WHATSAPP_MESSAGE_TYPE_CRITICO=template
PPG_WHATSAPP_TEMPLATE_NAME_CRITICO=pingpong_alert
PPG_WHATSAPP_TEMPLATE_LANG_CRITICO=pt_BR
