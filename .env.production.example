NODE_ENV=production
ALLOW_INSECURE_DEV_AUTH_DEFAULTS=false
FRONTEND_URL=https://pingpongpaidegua.vercel.app

# Obrigatorias: gere valores exclusivos para cada ambiente. Nao ha default seguro.
POSTGRES_PASSWORD=
JWT_SECRET=
# Em arquivos .env reais, coloque hashes bcrypt entre aspas simples para preservar os caracteres "$".
ADMIN_PASSWORD_HASH=

# URLs entregues pelo Compose ao servico api. Preserve os limites de pool adequados ao ambiente.
API_DATABASE_URL_WRITE=
API_DATABASE_URL_READ=

# URLs entregues pelo Compose ao servico worker. Nao reutilize os limites de pool da API.
WORKER_DATABASE_URL_WRITE=
WORKER_DATABASE_URL_READ=
