NODE_ENV=development
ALLOW_INSECURE_DEV_AUTH_DEFAULTS=true
API_PORT=4000
JWT_SECRET=change-this-local-jwt-secret
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin-local
ADMIN_PASSWORD_HASH=$2a$12$665oCAgtDnKAz4A9NLc/MOU3jd7wWdbLdrIWe9mIHwM6ypIzo45la
# Entradas usadas pelo docker-compose.yml na raiz do repositorio.
API_DATABASE_URL_WRITE=postgresql://postgres:postgres@postgres:5432/cbtm?connection_limit=8&pool_timeout=30&connect_timeout=10
API_DATABASE_URL_READ=postgresql://postgres:postgres@postgres:5432/cbtm?connection_limit=12&pool_timeout=30&connect_timeout=10
# Nomes internos usados ao executar a API diretamente, fora do Compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbtm?connection_limit=6&pool_timeout=30&connect_timeout=10
DATABASE_URL_WRITE=postgresql://postgres:postgres@localhost:5432/cbtm?connection_limit=6&pool_timeout=30&connect_timeout=10
DATABASE_URL_READ=postgresql://postgres:postgres@localhost:5432/cbtm?connection_limit=10&pool_timeout=30&connect_timeout=10
# Entrada usada pelo Compose para ativar requirepass no Redis local.
REDIS_PASSWORD=change-this-local-redis-password
REDIS_URL=redis://:change-this-local-redis-password@localhost:6379
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_REDIS_PREFIX=rl
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_LIMIT=600
RATE_LIMIT_HEAVY_LIMIT=120
RATE_LIMIT_STRICT_LIMIT=40
TRUST_PROXY=false
USER_LIST_DEFAULT_PAGE_SIZE=500
USER_LIST_MAX_PAGE_SIZE=2000
STATE_CIRCUIT_ELIGIBILITY_CACHE_TTL_MS=300000
FRONTEND_URL=http://localhost:3000
RAW_CAPTURE_RETENTION_DAYS_SUCCESS=14
RAW_CAPTURE_RETENTION_DAYS_ERROR=0
RAW_CAPTURE_MAX_RUNS_PER_EVENT=20
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_MS=30000
HEALTH_MONITOR_RECOVERY_ENABLED=true
HEALTH_MONITOR_STALE_LOCK_MS=900000
HEALTH_MONITOR_SCRAPE_LOOKBACK_MS=5400000
HEALTH_MONITOR_RECOVERY_COOLDOWN_MS=1200000
HEALTH_MONITOR_RECOVERY_MAX_EVENTS_PER_CYCLE=3
HEALTH_MONITOR_RECOVERY_MAX_ATTEMPTS_PER_EVENT=6
HEALTH_MONITOR_RECOVERY_ESCALATE_AFTER_CONSECUTIVE_DEGRADED=2
HEALTH_MONITOR_RECOVERY_ATTEMPT_WINDOW_MS=21600000
SCRAPE_CACHE_MARGIN_MS=600000
SCRAPE_CACHE_MIN_AGE_MS=60000
SCRAPE_CACHE_FALLBACK_AGE_MS=1800000
SCRAPE_INTERVAL_PRE_INSCRICOES_MS=18000000
SCRAPE_INTERVAL_INSCRICOES_ABERTAS_MS=21600000
SCRAPE_INTERVAL_POS_INSCRICOES_PRE_EVENTO_MS=3600000
SCRAPE_INTERVAL_GRADES_PUBLICADAS_PRE_JOGO_MS=1200000
SCRAPE_INTERVAL_EM_ANDAMENTO_MS=900000
