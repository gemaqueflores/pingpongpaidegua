NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cbtm
REDIS_URL=redis://redis:6379
SCRAPER_MODE=live
SCRAPER_EVENT_URL=https://app.cbtm.org.br/IUI/App/Evento?EVE_Evento_ID={EVENT_ID}
SCRAPER_FIXTURE_PATH=/workspace/fixtures/results.txt
SCRAPER_FIXTURE_PATHS=/workspace/fixtures/golden
SCRAPER_HEADLESS=true
SCRAPER_EXCLUDED_CATEGORY_IDS=88888888,99999999
SCRAPE_CAPTURE_TIMEOUT_MS=900000
SCRAPE_LOCK_STALE_MS=900000
SCRAPER_HTTP_ACCEPT_ENCODING=gzip, deflate, br
SCRAPER_RESULTADOS_FASE_MODE=true
SCRAPER_FETCH_ATLETAS_COMBO=true
SCRAPER_SANITIZE_OUTPUT=true
SCRAPER_CARDVIEW_PAGE_INDEX=-1
SCRAPER_CARDVIEW_PAGE_SIZE=12
SCRAPER_CARDVIEW_PAGE_ROWCOUNT=25
SCRAPER_HTTP_ONLY_CATEGORY_IDS=111
SCRAPER_REFRESH_CRON_MS=600000
SCRAPE_INTERVAL_PRE_INSCRICOES_MS=18000000
SCRAPE_INTERVAL_INSCRICOES_ABERTAS_MS=21600000
SCRAPE_INTERVAL_POS_INSCRICOES_PRE_EVENTO_MS=10800000
SCRAPE_INTERVAL_GRADES_PUBLICADAS_PRE_JOGO_MS=2700000
SCRAPE_INTERVAL_EM_ANDAMENTO_MS=1800000
SCRAPER_AUTO_SCRAPE_MAX_PENDING_JOBS=20
SCRAPER_AUTO_MAX_ENQUEUED_PER_SCAN=3
SCRAPE_RUN_RETENTION_LIMIT=5
STAGE3_PRUNE_STALE_MATCHES=true
STAGE3_INCREMENTAL_ENABLED=false
RAW_CAPTURE_RETENTION_DAYS_SUCCESS=14
RAW_CAPTURE_RETENTION_DAYS_ERROR=0
RAW_CAPTURE_MAX_RUNS_PER_EVENT=20
RAW_CAPTURE_CLEANUP_ENABLED=true
RAW_CAPTURE_CLEANUP_EVERY_MS=86400000
RAW_CAPTURE_SANITIZE_ENABLED=true
RAW_CAPTURE_MAX_BODY_CHARS=25000
RAW_CAPTURE_STORE_HTML=false
RAW_CAPTURE_HASH_ONLY_TABS=
CONFLICT_AUTO_CREATE_WARNING_ATHLETE_ENABLED=true
POST_SCRAPE_CONFLICT_AUTOFIX_ENABLED=true
POST_SCRAPE_CONFLICT_AUTOFIX_MAX_PER_RUN=200
POST_SCRAPE_CONFLICT_SCAN_MULTIPLIER=4
SCRAPE_STRICT_QUALITY_GATE_ENABLED=true
SCRAPE_STRICT_REQUIRE_ZERO_PENDING_CONFLICTS=true
SCRAPE_STRICT_REQUIRE_ZERO_NO_CANDIDATE_CONFLICTS=true
SCRAPE_STRICT_REQUIRE_CONFORMANCE=true
SCRAPE_PERSISTED_WARNINGS_MAX=60
SCRAPE_PERSISTED_WARNINGS_HIGH_MAX=15
SCRAPE_PERSISTED_WARNINGS_MEDIUM_MAX=20
